## =============================================================================
## view.vue.vm —— 代码生成器「Vue3 + TypeScript 详情抽屉(view)」模板
## -----------------------------------------------------------------------------
## 【务必理解】本文件是 Velocity 模板，不是可直接运行的 Vue 组件。渲染后生成一个
##   .vue 详情抽屉组件：${...} / $xxx 会被替换成真实值，#xxx 是指令。
##   因此模板里所有“说明文字”都必须写成 Velocity 注释，否则会被原样输出进生成
##   的 .vue 文件里。切勿用 JS 行注释、JS 块注释或 HTML 注释写说明性文字，
##   这些写法都会被原样输出。
##
## 【Velocity 注释语法】
##   ##           单行注释：注释到本行末尾，并连同该行换行一起被删除；整行以 ##
##                开头时，生成结果里不会留下空行。禁止把 ## 追加到“有输出内容的
##                行尾”，否则会吃掉该行换行导致内容被拼接。
##   #* ... *#    多行(块)注释：可跨行，块内内容不被引擎解析（不嵌套）。
##
## 【本模板涉及的 Velocity 语法】
##   ${name} / $name    引用：输出变量、属性或方法返回值。推荐用 ${} 包裹，
##                      避免与紧随其后的字符粘连（如 ${comment}：）。
##   #set($x = 值)      定义或赋值（本身不产生任何输出）；"=" 两侧建议留空格。
##   #foreach($c in $list) ... #end   遍历集合（$column 为当前元素）。
##   #if / #elseif / #else / #end    条件分支。
##   $obj.prop          属性访问（等价于调用 getProp()）。
##   $obj.method(参数)  方法调用，返回值参与输出。
##   #[[ ... ]]#        原样输出块：块内不被 Velocity 解析（本文件未用到）。
##   空白规则：指令独占一行时，Velocity 会连同该行换行一起删除，生成的 Vue 文件
##             里不会残留多余空行。注意 Vue 插值 {{ ... }} 与 Velocity 无关，原样保留。
## =============================================================================
<template>
  <el-drawer title="${functionName}详情" v-model="visible" direction="rtl" size="60%" append-to-body :before-close="handleClose" class="detail-drawer">
    <div v-loading="loading" class="drawer-content">
      <h4 class="section-header">基本信息</h4>
## #set：定义计数引用 $i（无输出），用于控制两列布局——每 2 个字段开/闭一个 el-row。
#set($i = 0)
## #foreach ... #end：遍历所有列（$columns 为列集合，$column 为当前列对象）。
#foreach($column in $columns)
## #if(条件)：条件为真才渲染块内内容。
## $column.pk / $column.list 为属性访问（引擎自动调用 isPk()/isList()）；
## 行首 "!" 为取反，这里表示“非主键且需要在列表中展示”的列才生成。
#if(!$column.pk && $column.list)
## #set + $obj.prop：$column.dictType 取字典类型，$column.javaField 取字段名。
#set($dictType=$column.dictType)
#set($javaField=$column.javaField)
## $obj.method(参数)：indexOf("（") 返回中文左括号下标，找不到返回 -1。
## 据此把注释 $comment 定位为括号前的名称，供后续拼接展示文本。
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
## substring(0, n)：截取子串（去掉注释里的括号说明部分）。
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
## #if/#end 独占一行：此处开始一行（$i 为偶数时），指令行会被引擎整行删除。
#if($i % 2 == 0)
      <el-row :gutter="20" class="mb8">
#end
        <el-col :span="12">
          <div class="info-item">
            <label class="info-label">${comment}：</label>
            <span class="info-value plaintext">
## ${comment} 用 ${} 包裹：避免与紧随其后的内容粘连解析。
## 下面按字段 htmlType 选择不同展示方式（字典 / 日期 / 图片 / 纯文本）。
#if("" != $dictType)
## 字典多选(checkbox)列的值是逗号串，需先 split(',') 再交给 dict-tag。
#if($column.htmlType == "checkbox")
              <dict-tag :options="${dictType}" :value="info.${javaField} ? info.${javaField}.split(',') : []" />
#else
              <dict-tag :options="${dictType}" :value="info.${javaField}" />
#end
#elseif($column.htmlType == "datetime")
              {{ parseTime(info.${javaField}, '{y}-{m}-{d}') }}
#elseif($column.htmlType == "imageUpload")
              <image-preview :src="info.${javaField}" :width="60" :height="60" />
#else
              {{ info.${javaField} }}
#end
            </span>
          </div>
        </el-col>
## #set 自增计数：每输出一个字段 +1（赋值表达式两侧留空格）。
#set($i = $i + 1)
## 每满 2 个字段关闭一行。
#if($i % 2 == 0)
      </el-row>
#end
#end
#end
## 收尾：若字段总数为奇数，最后一行未闭合，这里补一个 </el-row>。
#if($i % 2 != 0)
      </el-row>
#end
    </div>
  </el-drawer>
</template>

<script setup lang="ts" name="${BusinessName}ViewDrawer">
import type { ${ClassName} } from "@/types/api/${moduleName}/${businessName}"
import { get${BusinessName} } from '@/api/${moduleName}/${businessName}'
## ${dicts} 用 ${} 包裹（后面紧跟空格），引用边界更清晰、更安全。
#if(${dicts} != '')
## 字符串方法 replace：去掉字典名集合里的单引号，得到可解构的变量名列表。
#set($dictsNoSymbol=$dicts.replace("'", ""))

const { ${dictsNoSymbol} } = useDict(${dicts})
#end

const visible = ref<boolean>(false)
const loading = ref<boolean>(false)
const info = reactive<Partial<${ClassName}>>({})

## 行内 #if/#else/#end：同一行内按字段 Java 类型决定 TS 参数类型
## （Long/Integer → number，其它 → string）。指令不独占行，不会删除换行。
const open = async (#if($pkColumn.javaType == "Long" || $pkColumn.javaType == "Integer")${pkColumn.javaField}: number#else${pkColumn.javaField}: string#end): Promise<void> => {
  visible.value = true
  loading.value = true
  try {
    const res = await get${BusinessName}(${pkColumn.javaField})
    Object.assign(info, res.data ?? {})
  } catch (error) {
    console.error('获取${functionName}信息失败:', error)
  } finally {
    loading.value = false
  }
}

const handleClose = (): void => {
  visible.value = false
  Object.keys(info).forEach(key => delete (info as any)[key])
}

defineExpose({ open })
</script>
