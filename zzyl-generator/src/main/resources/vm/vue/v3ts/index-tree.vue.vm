</template>

<script setup lang="ts" name="${BusinessName}">
import { list${BusinessName}, get${BusinessName}, del${BusinessName}, add${BusinessName}, update${BusinessName} } from "@/api/${moduleName}/${businessName}"
## #if($genView) ... #end：开启详情时才引入详情抽屉组件。
#if($genView)
import ${BusinessName}ViewDrawer from "./view.vue"
#end
import type { ${ClassName}, ${BusinessName}QueryParams } from "@/types/api/${moduleName}/${businessName}"
import type { TreeSelect } from '@/types/api/common'

const { proxy } = getCurrentInstance()
## ${dicts} 用 ${} 包裹（后面紧跟空格），引用边界更清晰。
#if(${dicts} != '')
## 字符串方法 replace：去掉字典名集合里的单引号，得到可解构的变量名列表。
#set($dictsNoSymbol=$dicts.replace("'", ""))
const { ${dictsNoSymbol} } = useDict(${dicts})
#end

const ${businessName}List = ref<any[]>([])
const ${businessName}Options = ref<TreeSelect[]>([])
const open = ref<boolean>(false)
const loading = ref<boolean>(true)
const showSearch = ref<boolean>(true)
const title = ref<string>("")
const isExpandAll = ref<boolean>(true)
const refreshTable = ref<boolean>(true)
## 为“日期范围(BETWEEN)”查询列各生成一个日期范围 ref。
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
const daterange${AttrName} = ref([])
#end
#end

const data = reactive({
  form: {} as ${ClassName},
  queryParams: {
## 行内 #foreach：为每个查询列生成 "字段名: undefined" 的逗号分隔列表。
## $foreach.count 为当前循环计数(从 1 起)，$columns.size() 为集合大小；
## 仅非最后一项才补逗号，避免生成末尾多余逗号（非法 JS 对象字面量）。
    #foreach ($column in $columns)
#if($column.query)
    $column.javaField: undefined#if($foreach.count != $columns.size()),#end
#end
#end
  } as ${BusinessName}QueryParams,
  rules: {
## 为“必填”列生成校验规则，同样用 $foreach.count 控制结尾逗号。
    #foreach ($column in $columns)
#if($column.required)
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
    $column.javaField: [
## 行内 #if/#else：select/radio 用 change 触发校验，其它用 blur。
      { required: true, message: "$comment不能为空", trigger: #if($column.htmlType == "select" || $column.htmlType == "radio")"change"#else"blur"#end }
    ]#if($foreach.count != $columns.size()),#end
#end
#end
  }
})

const { queryParams, form, rules } = toRefs(data)

/** 查询${functionName}列表 */
function getList() {
  loading.value = true
## 若存在日期范围查询列，先初始化 params；#break 立即结束本循环（只需执行一次）。
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
  queryParams.value.params = {}
#break
#end
#end
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
  if (null != daterange${AttrName}.value && '' != daterange${AttrName}.value) {
    queryParams.value.params["begin${AttrName}"] = daterange${AttrName}.value[0]
    queryParams.value.params["end${AttrName}"] = daterange${AttrName}.value[1]
  }
#end
#end
  list${BusinessName}(queryParams.value).then(response => {
    ${businessName}List.value = proxy.handleTree(response.data, "${treeCode}", "${treeParentCode}")
    loading.value = false
  })
}

/** 查询${functionName}下拉树结构 */
function getTreeselect() {
  list${BusinessName}().then(response => {
    ${businessName}Options.value = []
## ${treeCode}/${treeName} 均用 ${} 包裹；此处构造“顶级节点”作为下拉树根。
    const data = { ${treeCode}: 0, ${treeName}: '顶级节点', children: [] }
    data.children = proxy.handleTree(response.data, "${treeCode}", "${treeParentCode}")
    ${businessName}Options.value.push(data)
  })
}
	
/** 取消按钮 */
function cancel() {
  open.value = false
  reset()
}

/** 表单重置 */
function reset() {
  form.value = {
## 重置表单：checkbox 列重置为数组，其它列重置为 null。
#foreach ($column in $columns)
#if($column.htmlType == "checkbox")
    $column.javaField: []#if($foreach.count != $columns.size()),#end
#else
    $column.javaField: null#if($foreach.count != $columns.size()),#end
#end
#end
  }
  proxy.resetForm("${businessName}Ref")
}

/** 搜索按钮操作 */
function handleQuery() {
  getList()
}

/** 重置按钮操作 */
function resetQuery() {
## 重置日期范围 ref 为空数组。
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
  daterange${AttrName}.value = []
#end
#end
  proxy.resetForm("queryRef")
  handleQuery()
}

/** 新增按钮操作 */
function handleAdd(row: ${ClassName}) {
  reset()
  getTreeselect()
  if (row != null && row.${treeCode}) {
    form.value.${treeParentCode} = row.${treeCode}
  } else {
    form.value.${treeParentCode} = 0
  }
  open.value = true
  title.value = "添加${functionName}"
}

/** 展开/折叠操作 */
function toggleExpandAll() {
  refreshTable.value = false
  isExpandAll.value = !isExpandAll.value
  nextTick(() => {
    refreshTable.value = true
  })
}
#if($genView)

/** 详情按钮操作 */
## #[[$]]# 原样输出字符 $，避免 Velocity 将 $refs 当引用解析。
function handleViewData(row: ${ClassName}) {
  proxy.#[[$]]#refs["${businessName}ViewRef"].open(row.${pkColumn.javaField})
}
#end

/** 修改按钮操作 */
async function handleUpdate(row: ${ClassName}) {
  reset()
  await getTreeselect()
  if (row != null) {
    form.value.${treeParentCode} = row.${treeParentCode}
  }
  get${BusinessName}(row.${pkColumn.javaField}!).then(response => {
    form.value = response.data
## checkbox 多选字段：接口返回的是逗号串，编辑时需 split(',') 还原为数组。
#foreach ($column in $columns)
#if($column.htmlType == "checkbox")
    form.value.$column.javaField = form.value.${column.javaField}.split(",")
#end
#end
    open.value = true
    title.value = "修改${functionName}"
  })
}

/** 提交按钮 */
function submitForm() {
## #[[ ... ]]# 原样输出块：#[[$]]# 会原样保留为字符 $，避免 Velocity 把它当引用解析。
  proxy.#[[$]]#refs["${businessName}Ref"].validate((valid: boolean) => {
    if (valid) {
## 提交前把 checkbox 数组字段 join(',') 回写成逗号串再提交给后端。
#foreach ($column in $columns)
#if($column.htmlType == "checkbox")
      form.value.$column.javaField = form.value.${column.javaField}.join(",")
#end
#end
      if (form.value.${pkColumn.javaField} != null) {
        update${BusinessName}(form.value).then(() => {
## #[[$modal]]#：块内 $modal 原样输出，Velocity 不解析（指向全局弹窗工具）。
          proxy.#[[$modal]]#.msgSuccess("修改成功")
          open.value = false
          getList()
        })
      } else {
        add${BusinessName}(form.value).then(() => {
          proxy.#[[$modal]]#.msgSuccess("新增成功")
          open.value = false
          getList()
        })
      }
    }
  })
}

/** 删除按钮操作 */
function handleDelete(row: ${ClassName}) {
  proxy.#[[$modal]]#.confirm('是否确认删除${functionName}编号为"' + row.${pkColumn.javaField} + '"的数据项？').then(function() {
    return del${BusinessName}(row.${pkColumn.javaField}!)
  }).then(() => {
    getList()
    proxy.#[[$modal]]#.msgSuccess("删除成功")
  }).catch(() => {})
}

getList()
</script>
