## =============================================================================
## index.vue.vm —— 代码生成器「列表页」模板（Vue2 + Element UI）
## -----------------------------------------------------------------------------
## 【生成物】渲染后得到一个 .vue 单文件组件：列表页（查询表单 + 工具栏 + 数据
##   表格 + 新增/修改对话框；主子表时附带子表编辑区；可选详情抽屉）。
##   本文件是 Velocity 模板，不是 Vue 源码：#xxx 是指令，${...}/$xxx 是引用，
##   渲染时被替换成真实值。因此一切“说明文字”都必须写成 Velocity 注释。
## -----------------------------------------------------------------------------
## 【Velocity 注释语法】
##   ##           单行注释：注释到本行末尾，并连同该行换行一起删除。必须独占
##                整行——若写在有输出内容的行尾，会把该行换行吃掉，导致生成
##                内容被拼接。本文件所有 ## 注释均独占整行。
##   #* ... *#    多行(块)注释：可跨行，遇第一个 *# 结束（不嵌套）。
## -----------------------------------------------------------------------------
## 【本模板用到的 Velocity 语法】
##   ${name} / $name        引用：输出变量、属性或方法返回值。推荐 ${} 包裹，
##                          以免与紧随其后的字符粘连（如 ${businessName}List）。
##   $obj.prop              属性访问（等价于调用 getProp()）。
##   $obj.method(...)       方法调用，返回值参与输出（如 substring/indexOf/size）。
##   #set($x = 表达式)      给引用赋值，本身不产生输出。
##   #foreach($i in $list) ... #end         遍历循环；可用 #break 提前跳出。
##   #if(...) ... #elseif(...) ... #else ... #end   条件分支。
##   $foreach.count         循环计数（从 1 开始）；$foreach.index 从 0 开始。
##   #[[ ... ]]#            字面块：块内内容不被 Velocity 解析，原样输出，用于
##                          表示 Vue/JS 里的 $refs、$modal、${...} 等。
##   空白规则：指令独占一行（行首行尾仅有空白）时，Velocity 会连同该行换行一起
##             删除，生成结果中不会留下多余空行；而写在行内的 #if ... #end（如
##             拼接逗号处）不可在其行尾追加 ## 注释。
## -----------------------------------------------------------------------------
## 【与 Vue/JS 语法并存，务必区分】
##   {{ ... }}         是 Vue 插值，与 Velocity 无关，原样保留。
##   反引号内 ${...}   是 JS 模板字符串语法，须原样保留（必要时用 #[[ ]]# 保护）。
##   CSS 的 #fff、选择器中的 # 同理，均与 Velocity 无关。
## =============================================================================
<template>
  <div class="app-container">
    <el-form :model="queryParams" ref="queryForm" size="small" :inline="true" v-show="showSearch" label-width="68px">
## ↓ 查询条件区：#foreach ... #end 遍历列集合 $columns，$column 为当前列对象。
#foreach($column in $columns)
## $column.query 为布尔属性，Velocity 自动调用其 getter；为真才生成该列查询项。
#if($column.query)
## #set：局部变量赋值（无输出）。下面预处理字典类型与首字母大写的字段名。
## $column.javaField.substring(0,1).toUpperCase() + substring(1) 为方法调用拼接。
#set($dictType=$column.dictType)
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
## 列注释常形如「名称（说明）」：indexOf("（") 定位中文左括号下标，未找到为 -1。
#set($parentheseIndex=$column.columnComment.indexOf("（"))
## 据此截取括号前的纯名称存入 $comment（#if/#else 分支，后面 #end 收尾）。
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
## 依列的 htmlType（控件类型）选择查询控件；#elseif 递进分支，最终统一 #end。
#if($column.htmlType == "input")
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-input
          v-model="queryParams.${column.javaField}"
          placeholder="请输入${comment}"
          clearable
          @keyup.enter.native="handleQuery"
        />
      </el-form-item>
#elseif(($column.htmlType == "select" || $column.htmlType == "radio") && "" != $dictType)
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-select v-model="queryParams.${column.javaField}" placeholder="请选择${comment}" clearable>
          <el-option
            v-for="dict in dict.type.${dictType}"
            :key="dict.value"
            :label="dict.label"
            :value="dict.value"
          />
        </el-select>
      </el-form-item>
#elseif(($column.htmlType == "select" || $column.htmlType == "radio") && $dictType)
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-select v-model="queryParams.${column.javaField}" placeholder="请选择${comment}" clearable>
          <el-option label="请选择字典生成" value="" />
        </el-select>
      </el-form-item>
#elseif($column.htmlType == "datetime" && $column.queryType != "BETWEEN")
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-date-picker clearable
          v-model="queryParams.${column.javaField}"
          type="date"
          value-format="yyyy-MM-dd"
          placeholder="请选择${comment}">
        </el-date-picker>
      </el-form-item>
## BETWEEN 查询：生成日期范围选择器，绑定到 daterange${AttrName}。
#elseif($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
      <el-form-item label="${comment}">
        <el-date-picker
          v-model="daterange${AttrName}"
          style="width: 240px"
          value-format="yyyy-MM-dd"
          type="daterange"
          range-separator="-"
          start-placeholder="开始日期"
          end-placeholder="结束日期"
        ></el-date-picker>
      </el-form-item>
## 此处三个 #end 依次闭合：htmlType 的 #if、#if($column.query)、#foreach($columns)。
#end
#end
#end
      <el-form-item>
        <el-button type="primary" icon="el-icon-search" size="mini" @click="handleQuery">搜索</el-button>
        <el-button icon="el-icon-refresh" size="mini" @click="resetQuery">重置</el-button>
      </el-form-item>
    </el-form>

## ${permissionPrefix} 为引用，输出权限前缀，用于拼 v-hasPermi 权限标识。
## 注意：v-hasPermi="['...']" 整体是 Vue 指令表达式，与 Velocity 无关。
    <el-row :gutter="10" class="mb8">
