<script>
## 以下是 <script> 段：${BusinessName} 类名(大驼峰)、${businessName} 业务名(小驼峰)、
## ${moduleName} 模块名，用于拼接 API 请求路径。
import { list${BusinessName}, get${BusinessName}, del${BusinessName}, add${BusinessName}, update${BusinessName} } from "@/api/${moduleName}/${businessName}"
## 仅在生成详情页时导入详情抽屉组件。
#if($genView)
import ${BusinessName}ViewDrawer from "./view"
#end

export default {
  name: "${BusinessName}",
#if($genView)
  components: { ${BusinessName}ViewDrawer },
#end
## ${dicts}(引用)为字典配置代码文本，非空时才输出 dicts 项；'' 为字符串常量。
#if(${dicts} != '')
  dicts: [${dicts}],
#end
  data() {
    return {
      // 遮罩层
      loading: true,
      // 选中数组
      ids: [],
## 主子表时的选中数组；${subClassName} 为子表类名引用。
#if($table.sub)
      // 子表选中数据
      checked${subClassName}: [],
#end
      // 非单个禁用
      single: true,
      // 非多个禁用
      multiple: true,
      // 显示搜索条件
      showSearch: true,
      // 总条数
      total: 0,
      // ${functionName}表格数据
      ${businessName}List: [],
## 主子表时的子表数据数组。
#if($table.sub)
      // ${subTable.functionName}表格数据
      ${subclassName}List: [],
#end
      // 弹出层标题
      title: "",
      // 是否显示弹出层
      open: false,
## 为 BETWEEN 查询生成日期范围绑定变量；$AttrName 由 #set 拼接得到。
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
      // $comment时间范围
      daterange${AttrName}: [],
#end
#end
      // 查询参数
      queryParams: {
        pageNum: 1,
        pageSize: 10,
## 组装查询参数对象：遍历查询列，输出分页参数以外的查询字段。
#foreach ($column in $columns)
#if($column.query)
## $foreach.count 为当前轮次(从 1 开始)，$columns.size() 为列总数。
## 内联 #if($foreach.count != $columns.size()),#end 仅在非末项时补逗号，避免尾逗号。
## 注意：该 #if/#end 位于同一行内，其行尾严禁追加 ## 注释（会吞掉换行）。
        $column.javaField: null#if($foreach.count != $columns.size()),#end
#end
#end
      },
      // 表单参数
      form: {},
      // 表单校验
      rules: {
## 表单校验：仅为必填列($column.required)生成 rules 项。
#foreach ($column in $columns)
#if($column.required)
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
        $column.javaField: [
## 行内三元：#if/#else 在 "change"/"blur" 间选择 trigger 值（同样不可行尾加 ## ）。
          { required: true, message: "$comment不能为空", trigger: #if($column.htmlType == "select" || $column.htmlType == "radio")"change"#else"blur"#end }
        ]#if($foreach.count != $columns.size()),#end
#end
#end
      }
    }
  },
  created() {
    this.getList()
  },
  methods: {
    /** 查询${functionName}列表 */
    getList() {
      this.loading = true
## 遍历列寻找 BETWEEN 查询列；找到即初始化 params 对象并用 #break 跳出 #foreach。
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
      this.queryParams.params = {}
#break
#end
#end
## 再次遍历，把日期范围数组拆成 begin/end 两个查询参数。
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
      if (null != this.daterange${AttrName} && '' != this.daterange${AttrName}) {
        this.queryParams.params["begin${AttrName}"] = this.daterange${AttrName}[0]
        this.queryParams.params["end${AttrName}"] = this.daterange${AttrName}[1]
      }
#end
#end
## ${BusinessName} 为引用，拼出接口方法名（如 listUser）。
      list${BusinessName}(this.queryParams).then(response => {
        this.${businessName}List = response.rows
        this.total = response.total
        this.loading = false
      })
    },
    // 取消按钮
    cancel() {
      this.open = false
      this.reset()
    },
    // 表单重置
    reset() {
      this.form = {
## 表单重置：遍历列，checkbox 列置空数组 []，其余置 null。
#foreach ($column in $columns)
#if($column.htmlType == "checkbox")
        $column.javaField: []#if($foreach.count != $columns.size()),#end
#else
        $column.javaField: null#if($foreach.count != $columns.size()),#end
#end
#end
      }
## 同时重置子表数据。
#if($table.sub)
      this.${subclassName}List = []
#end
      this.resetForm("form")
    },
    /** 搜索按钮操作 */
    handleQuery() {
      this.queryParams.pageNum = 1
      this.getList()
    },
    /** 重置按钮操作 */
    resetQuery() {
## 重置查询条件：仅处理 BETWEEN 日期范围变量。
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
      this.daterange${AttrName} = []
#end
#end
      this.resetForm("queryForm")
      this.handleQuery()
    },
    // 多选框选中数据
    handleSelectionChange(selection) {
## ${pkColumn} 为主键列对象，其 javaField 属性即主键字段名。
      this.ids = selection.map(item => item.${pkColumn.javaField})
      this.single = selection.length !== 1
      this.multiple = !selection.length
    },
    /** 新增按钮操作 */
    handleAdd() {
      this.reset()
      this.open = true
      this.title = "添加${functionName}"
    },
    /** 修改按钮操作 */
    handleUpdate(row) {
      this.reset()
      const ${pkColumn.javaField} = row.${pkColumn.javaField} || this.ids
      get${BusinessName}(${pkColumn.javaField}).then(response => {
        this.form = response.data
## 修改回显：checkbox 列需把逗号串拆成数组。
#foreach ($column in $columns)
#if($column.htmlType == "checkbox")
        this.form.$column.javaField = this.form.${column.javaField}.split(",")
#end
#end
## 回显子表数据。
#if($table.sub)
        this.${subclassName}List = response.data.${subclassName}List
#end
        this.open = true
        this.title = "修改${functionName}"
      })
    },
    /** 提交按钮 */
    submitForm() {
## #[[ ... ]]# 为字面块：块内不被 Velocity 解析，原样输出。
## 此处 this.#[[$]]#refs 用于输出 Vue 的 this.$refs（否则 $refs 会被当作引用）。
      this.#[[$]]#refs["form"].validate(valid => {
        if (valid) {
## 提交前把 checkbox 列数组拼回逗号串。
#foreach ($column in $columns)
#if($column.htmlType == "checkbox")
          this.form.$column.javaField = this.form.${column.javaField}.join(",")
#end
#end
## 提交时携带子表数据。
#if($table.sub)
          this.form.${subclassName}List = this.${subclassName}List
#end
          if (this.form.${pkColumn.javaField} != null) {
            update${BusinessName}(this.form).then(response => {
## #[[$modal]]# 同理：原样输出字面量 $modal。
              this.#[[$modal]]#.msgSuccess("修改成功")
              this.open = false
              this.getList()
            })
          } else {
            add${BusinessName}(this.form).then(response => {
              this.#[[$modal]]#.msgSuccess("新增成功")
              this.open = false
              this.getList()
            })
          }
        }
      })
    },
    /** 删除按钮操作 */
    handleDelete(row) {
      const ${pkColumn.javaField}s = row.${pkColumn.javaField} || this.ids
      this.#[[$modal]]#.confirm('是否确认删除${functionName}编号为"' + ${pkColumn.javaField}s + '"的数据项？').then(function() {
        return del${BusinessName}(${pkColumn.javaField}s)
      }).then(() => {
        this.getList()
        this.#[[$modal]]#.msgSuccess("删除成功")
      }).catch(() => {})
    },
## 以下为子表相关方法，仅在 $table.sub 为真时生成。
#if($table.sub)
	/** ${subTable.functionName}序号 */
    row${subClassName}Index({ row, rowIndex }) {
      row.index = rowIndex + 1
    },
    /** ${subTable.functionName}添加按钮操作 */
    handleAdd${subClassName}() {
      let obj = {}
## 遍历子表列，构造空白行对象。
#foreach($column in $subTable.columns)
## 跳过子表主键列与外键列。
#if($column.pk || $column.javaField == ${subTableFkclassName})
#elseif($column.list && "" != $javaField)
      obj.$column.javaField = ""
#end
#end
      this.${subclassName}List.push(obj)
    },
    /** ${subTable.functionName}删除按钮操作 */
    handleDelete${subClassName}() {
      if (this.checked${subClassName}.length == 0) {
        this.#[[$modal]]#.msgError("请先选择要删除的${subTable.functionName}数据")
      } else {
        const ${subclassName}List = this.${subclassName}List
        const checked${subClassName} = this.checked${subClassName}
        this.${subclassName}List = ${subclassName}List.filter(function(item) {
          return checked${subClassName}.indexOf(item.index) == -1
        })
      }
    },
    /** 复选框选中数据 */
    handle${subClassName}SelectionChange(selection) {
      this.checked${subClassName} = selection.map(item => item.index)
    },
#end
## 详情按钮：经 #[[$]]# 保护后输出 this.$refs，调用抽屉组件 open 方法。
#if($genView)
    /** 详情按钮操作 */
    handleViewData(row) {
      this.#[[$]]#refs["${businessName}ViewRef"].open(row.${pkColumn.javaField})
    },
#end
    /** 导出按钮操作 */
    handleExport() {
      this.download('${moduleName}/${businessName}/export', {
        ...this.queryParams
## #[[ ... ]]# 保护 JS 模板字符串里的 ${new Date().getTime()}：
## 它属 JS 语法，须原样输出，不能用 Velocity 引用解释；${businessName} 仍是引用。
      }, `${businessName}_#[[${new Date().getTime()}]]#.xlsx`)
    }
  }
}
</script>
