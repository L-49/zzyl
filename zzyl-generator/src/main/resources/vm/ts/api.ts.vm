## =============================================================================
## api.ts.vm —— 代码生成器「前端 API 请求(TypeScript)」模板
## -----------------------------------------------------------------------------
## 【务必理解】本文件是 Velocity 模板，不是 TypeScript 源码。它会被渲染成一个前端
##   api.ts 文件：${...} 会被引擎替换成真实值，#xxx 才是指令。
##   模板中一切“说明文字”都必须写成 Velocity 注释，切勿新增 // 或 /* */ 说明。
##   （本文件中原有的 // 注释是 TS 内容，会被原样输出，属于刻意保留。）
##
## 【Velocity 注释语法】
##   ##           单行注释：注释到本行末尾，并连同该行换行一起被删除；
##                整行以 ## 开头时，生成结果里不会留下空行。
##   #* ... *#    多行(块)注释：可跨行，不嵌套，遇到第一个 *# 即结束。
##
## 【本模板涉及的 Velocity 语法】
##   ${name}      引用(Reference)：输出变量；本文件全部使用 ${} 形式，避免与相邻字符粘连。
##   #if(条件) ... #else ... #end   条件分支。
##   空白规则：当指令独占一行（行首行尾仅有空白）时，Velocity 会连同该行换行
##             一起删除，所以生成的 TS 里不会出现多余空行。
##   提醒：${ClassName}[] 等写法中，[] 属于 TypeScript，Velocity 只替换 ${ClassName}。
## =============================================================================
## 引入请求封装与类型定义；${ClassName}=实体类名，${BusinessName}=业务名(大驼峰)。
import request from '@/utils/request'
import type { AjaxResult, TableDataInfo, ${BusinessName}QueryParams, ${ClassName} } from '@/types'

// 查询${functionName}列表
## #if/#else/#end 分支：树表返回 AjaxResult（参数可选），普通表返回分页的 TableDataInfo。
#if($table.tree)
export function list${BusinessName}(query?: ${BusinessName}QueryParams): Promise<AjaxResult<${ClassName}[]>> {
#else
export function list${BusinessName}(query: ${BusinessName}QueryParams): Promise<TableDataInfo<${ClassName}[]>> {
#end
  return request({
    url: '/${moduleName}/${businessName}/list',
    method: 'get',
    params: query
  })
}

// 查询${functionName}详细
## ${pkColumn.javaField}=主键属性名，作为函数形参(str 类型 number)并拼接进 URL。
export function get${BusinessName}(${pkColumn.javaField}: number): Promise<AjaxResult<${ClassName}>> {
  return request({
    url: '/${moduleName}/${businessName}/' + ${pkColumn.javaField},
    method: 'get'
  })
}

// 新增${functionName}
export function add${BusinessName}(data: ${ClassName}): Promise<AjaxResult> {
  return request({
    url: '/${moduleName}/${businessName}',
    method: 'post',
    data: data
  })
}

// 修改${functionName}
export function update${BusinessName}(data: ${ClassName}): Promise<AjaxResult> {
  return request({
    url: '/${moduleName}/${businessName}',
    method: 'put',
    data: data
  })
}

// 删除${functionName}
export function del${BusinessName}(${pkColumn.javaField}: number | number[]): Promise<AjaxResult> {
  return request({
    url: '/${moduleName}/${businessName}/' + ${pkColumn.javaField},
    method: 'delete'
  })
}


